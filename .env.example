# Environment Configuration
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="ModelOps Platform"
API_KEY=modelops-secret-key-change-in-production

# Server Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database Configuration
# For local SQLite: sqlite:///./modelops.db
# For PostgreSQL: postgresql://modelops:modelops_pass@localhost:5432/modelops_db
DATABASE_URL=sqlite:///./modelops.db
DB_ECHO=False

# MLflow Tracking
MLFLOW_TRACKING_URI=./artifacts/mlruns
MLFLOW_EXPERIMENT_NAME=breast_cancer_wisconsin

# Artifact Storage
ARTIFACT_STORE_PATH=./artifacts
MODEL_REGISTRY_PATH=./artifacts/models

# Monitoring
PROMETHEUS_METRICS_PATH=/metrics
EVIDENTLY_REPORTS_PATH=./artifacts/reports
